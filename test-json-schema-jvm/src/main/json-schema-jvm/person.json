{
  "$schema" : "http://json-schema.org/draft-07/schema#",
  "title" : "Person",
  "type" : "object",
  "additionalProperties" : false,
  "properties" : {
    "name" : {
      "type" : "string"
    },
    "age" : {
      "type" : "integer"
    },
    "date" : {
      "type" : "string",
      "format" : "date"
    },
    "time" : {
      "type" : "string",
      "format" : "time"
    },
    "dateTime" : {
      "type" : "string",
      "format" : "date-time"
    },
    "instant" : {
      "type" : "string",
      "format" : "date-time"
    },
    "nullableField" : {
      "type" : "integer"
    }
  },
  "required" : [ "name", "age", "date", "time", "dateTime", "instant" ]
}